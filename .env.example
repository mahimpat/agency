# ---- Site ----
BASE_URL=http://localhost:8000          # your public https:// address in production
SECRET_KEY=                              # long random string (required in production): python -c "import secrets; print(secrets.token_urlsafe(48))"
DATA_DIR=data                            # uploads and letter PDFs (use a persistent disk in production)
# DATABASE_URL=postgresql://...          # Supabase/Postgres in production (pip install ".[postgres]"); SQLite in DATA_DIR if unset

# ---- Company details (shown in the privacy policy and terms) ----
COMPANY_LEGAL_NAME=Forem Innovations     # e.g. "Forem Innovations Ltd" if it's a limited company
COMPANY_NUMBER=
COMPANY_ADDRESS=
ICO_NUMBER=
CONTACT_EMAIL=
HOSTING_PROVIDER=                        # e.g. "Render (EU)" - named in the privacy policy
EMAIL_PROVIDER=                          # e.g. "Postmark" - named in the privacy policy

# ---- AI ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STORY=price_...             # £7/month recurring price
STRIPE_PRICE_PENPAL=price_...            # £12/month recurring price

# ---- Printing and posting (Stannp, UK) ----
STANNP_API_KEY=
# STANNP_API_URL=https://api-eu1.stannp.com/v1
LIVE_MAIL=false                          # false = Stannp test proofs only; true = really print and post
REVIEW_ALL=true                          # true = a person approves every letter before posting

# ---- Cost guards (per child, per 30 days) ----
PARENT_REWRITES_PER_MONTH=2             # "ask for changes" rewrites when previewing
REPLY_UPLOADS_PER_MONTH=4               # child replies read by the AI

# ---- Daily job ----
CRON_SECRET=                             # a scheduler calls POST /internal/run-due with "Authorization: Bearer <CRON_SECRET>"

# ---- Email (SMTP); without these, emails are written to the log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Letters from History <hello@yourdomain.co.uk>
ADMIN_EMAIL=                             # gets "letters waiting for review" emails

# ---- Optional ----
# CHROME=/path/to/chrome                 # if Chrome/Chromium isn't found automatically
# LOB_API_KEY=test_...                   # US only
