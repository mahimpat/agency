# Required: Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# UK print and post (https://www.stannp.com). Letters are test proofs unless you pass --live.
STANNP_API_KEY=...
# Optional: only if your Stannp dashboard shows a different API URL
# STANNP_API_URL=https://dash.stannp.com/api/v1
# Optional, US only: Lob print and mail. Use a test_ key for proofs.
# LOB_API_KEY=test_...
# Optional: path to Chrome/Chromium for making PDFs, if it isn't found automatically
# CHROME=/path/to/chrome
